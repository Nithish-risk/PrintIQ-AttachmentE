from __future__ import annotations
from collections import defaultdict
from pathlib import Path
from typing import Iterable, Dict, List, Optional, Tuple
import math, re
from PIL import Image, ImageDraw
try:
    import fitz
except Exception:
    fitz = None
from config.constants import Status

STATUS_COLORS_HEX={Status.PASS.value:'#16A34A',Status.FAIL.value:'#DC2626',Status.REVIEW_REQUIRED.value:'#6246EA'}

def _hex_rgb(h):
    h=(h or '#2563EB').lstrip('#'); return tuple(int(h[i:i+2],16) for i in (0,2,4))
def _finite(v):
    try:return math.isfinite(float(v))
    except Exception:return False

def _normal_text(v):
    return ' '.join(re.sub(r'[^A-Z0-9]+',' ',str(v or '').upper()).split())

def _label_candidates(result):
    """Longest-to-shortest printed-label candidates. Never includes actual value."""
    meta=getattr(result,'metadata',{}) or {}
    raw=[]
    for v in (meta.get('di_key'),getattr(result,'item',None),getattr(result,'expected',None)):
        if v and str(v).strip(): raw.append(str(v).strip())
    out=[]
    for text in raw:
        variants=[text]
        # Workbook descriptions after a separator frequently are component names,
        # while the printed stable label is the parent stem.
        for sep in (' - ',' – ',' — '):
            if sep in text:
                left=text.split(sep,1)[0].strip()
                if len(_normal_text(left))>=4: variants.append(left)
        # Canonical multi-part names may omit the spaced separator.
        m=re.split(r'\b(?:FIRST|MIDDLE|LAST|SUFFIX|TITLE)\b',text,flags=re.I,maxsplit=1)
        if len(m)>1:
            left=m[0].rstrip(' -–—,:()')
            if len(_normal_text(left))>=4: variants.append(left)
        # Checkbox instructions are not part of the printed question stem.
        left=re.split(r'\bCHECK\s+ALL\b|\bCHOOSE\s+ONE\b|\(ENTER\s+THE\s+HIGHEST',text,flags=re.I,maxsplit=1)[0].rstrip(' -–—,:()')
        if len(_normal_text(left))>=4: variants.append(left)
        for v in variants:
            n=_normal_text(v)
            if n and n not in {_normal_text(x) for x in out}: out.append(v)
    return out

def _old_hint(result):
    b=getattr(result,'bbox',None)
    if b is None:return None
    vals=[getattr(b,k,None) for k in ('x0','y0','x1','y1')]
    if not all(_finite(x) for x in vals):return None
    return tuple(float(x) for x in vals)

def _rect_score(page_no,rect,candidate,result):
    score=len(_normal_text(candidate))*10.0
    hint_page=getattr(result,'page',None)
    if hint_page and int(hint_page)==page_no: score+=10000
    hint=_old_hint(result)
    if hint:
        hx=(hint[0]+hint[2])/2; hy=(hint[1]+hint[3])/2
        # old geometry is used only to choose among repeated label occurrences.
        # It is never drawn.
        if max(map(abs,hint))<=1.5:
            score-=1000*((rect.x0/rect.width if rect.width else 0)-hx)**2
        else:
            score-=0.01*((rect.x0+rect.x1)/2-hx)**2
    return score

def resolve_label_targets(pdf_path,results):
    """Return model copies whose bbox is the exact printed LABEL rectangle only."""
    if fitz is None: raise RuntimeError('PyMuPDF is required for label-only overlays.')
    doc=fitz.open(str(pdf_path),filetype='pdf'); used=set(); resolved=[]; missing=[]
    try:
        for result in results:
            options=[]
            for candidate in _label_candidates(result):
                for pi,page in enumerate(doc):
                    for rect in page.search_for(candidate,quads=False):
                        key=(pi,round(rect.x0,1),round(rect.y0,1),round(rect.x1,1),round(rect.y1,1))
                        if key in used: continue
                        options.append((_rect_score(pi+1,rect,candidate,result),candidate,pi,rect,key))
            if not options:
                missing.append(getattr(result,'id',''))
                continue
            _,candidate,pi,rect,key=max(options,key=lambda x:x[0]); used.add(key)
            page=doc[pi]; w,h=float(page.rect.width),float(page.rect.height)
            from models.validation_models import BBox
            copy=result.model_copy(deep=True) if hasattr(result,'model_copy') else result
            copy.page=pi+1
            copy.bbox=BBox(page=pi+1,x0=rect.x0/w,y0=rect.y0/h,x1=rect.x1/w,y1=rect.y1/h,normalized=True)
            copy.metadata=dict(getattr(copy,'metadata',{}) or {})
            copy.metadata.update({'overlay_target':'LABEL_ONLY','overlay_label_text':candidate,'overlay_status_source':'FINAL_REVIEWER_STATUS'})
            resolved.append(copy)
    finally: doc.close()
    return resolved,{'eligible':len(results),'labels_located':len(resolved),'labels_not_located':len(missing),'missing_result_ids':missing}

def group_results_by_page(results:Iterable)->Dict[int,List]:
    out=defaultdict(list)
    for r in results:
        p=getattr(r,'page',None) or getattr(getattr(r,'bbox',None),'page',None)
        if p is not None: out[max(0,int(p)-1)].append(r)
    return dict(out)

def _pixel_rect(result,w,h):
    b=getattr(result,'bbox',None)
    if b is None:return None
    v=[getattr(b,k,None) for k in ('x0','y0','x1','y1')]
    if not all(_finite(x) for x in v):return None
    x0,y0,x1,y1=map(float,v)
    if max(map(abs,v))<=1.5:x0,x1,y0,y1=x0*w,x1*w,y0*h,y1*h
    return x0,y0,x1,y1

def render_page_to_pil(pdf_path,page_index,dpi=150):
    if fitz is None:raise RuntimeError('PyMuPDF is required.')
    doc=fitz.open(str(pdf_path)); page=doc[max(0,min(int(page_index),len(doc)-1))]
    pix=page.get_pixmap(matrix=fitz.Matrix(dpi/72,dpi/72),alpha=False)
    image=Image.frombytes('RGB',[pix.width,pix.height],pix.samples); doc.close(); return image

def render_page_with_results(pdf_path,page_index,results,dpi=150,color_map=None,legend_statuses=None):
    image=render_page_to_pil(pdf_path,page_index,dpi); draw=ImageDraw.Draw(image,'RGBA'); cmap=color_map or STATUS_COLORS_HEX
    for r in results:
        rect=_pixel_rect(r,image.width,image.height)
        if not rect:continue
        color=_hex_rgb(cmap.get(r.status.value,'#6246EA'))
        draw.rectangle(rect,fill=(*color,46),outline=(*color,235),width=3)
    return image

def _pdf_rect(r,page):
    b=getattr(r,'bbox',None)
    if b is None:return None
    vals=[getattr(b,k,None) for k in ('x0','y0','x1','y1')]
    if not all(_finite(x) for x in vals):return None
    x0,y0,x1,y1=map(float,vals); w,h=page.rect.width,page.rect.height
    if max(map(abs,vals))<=1.5:x0,x1,y0,y1=x0*w,x1*w,y0*h,y1*h
    return fitz.Rect(x0,y0,x1,y1)

def build_annotated_pdf_bytes(pdf_path,results,color_map=None,enabled_statuses=None):
    if fitz is None:raise RuntimeError('PyMuPDF is required.')
    cmap=color_map or STATUS_COLORS_HEX; enabled=set(enabled_statuses or cmap)
    doc=fitz.open(str(pdf_path),filetype='pdf')
    try:
        for r in results:
            if r.status.value not in enabled:continue
            p=(getattr(r,'page',None) or getattr(getattr(r,'bbox',None),'page',1))-1
            if p<0 or p>=len(doc):continue
            page=doc[p]; rect=_pdf_rect(r,page)
            if rect is None:continue
            rgb=tuple(x/255 for x in _hex_rgb(cmap.get(r.status.value,'#6246EA')))
            page.draw_rect(rect,color=rgb,fill=rgb,width=1.4,fill_opacity=.18,overlay=True)
        return doc.tobytes(garbage=4,deflate=True)
    finally:doc.close()
